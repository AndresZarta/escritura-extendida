---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import { withBase } from "../config";
import { Image } from "astro:assets";

// Get all blog posts from the content collection
const allPosts = await getCollection('blog', ({ data }) => {
  return data.draft !== true;
});

// Sort by date (most recent first) and take the 3 most recent
const posts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---
<Base title="escritura::extendida">
  <!-- Spacer -->
  <div class="spacer-large" aria-hidden="true"></div>

  <!-- Posts Section -->
  <div class="posts-container">
    <div class="posts-wrapper">
      <!-- Left Column: Sticky Heading -->
      <aside class="posts-sidebar">
        <div class="posts-sidebar-content">
          <h2 class="posts-heading">Posts Recientes:</h2>
        </div>
      </aside>

      <!-- Right Column: Posts List -->
      <div class="posts-list">
        {posts.map((post) => (
          <article class="post-item">
            {post.data.image && (
              <a href={withBase(`/blog/${post.slug}/`)} class="post-thumbnail">
                <Image 
                  src={post.data.image} 
                  alt={post.data.title}
                  width={50}
                  height={50}
                  loading="lazy"
                  decoding="async"
                />
              </a>
            )}
            
            <div class="post-header">
              <h3 class="post-item-title">
                <a href={withBase(`/blog/${post.slug}/`)}>{post.data.title}</a>
              </h3>
              <time class="post-date" datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('es-ES', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric'
                })}
              </time>
            </div>

            <p class="post-excerpt">{post.data.description}</p>

            <div class="post-spacer"></div>
          </article>
        ))}
      </div>
    </div>
  </div>
</Base>

