---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { formatDateET } from '../utils/formatDateET';

// Get all blog posts from the content collection
const allPosts = await getCollection('blog', ({ data }) => {
  return data.draft !== true;
});

// Sort by date (most recent first) and take the 3 most recent
const posts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---
<Base title="escritura::extendida">
  <!-- Spacer -->
  <div class="spacer-large" aria-hidden="true"></div>

  <!-- Posts Section -->
  <div class="posts-container">
    <aside class="intro-aside">
      <h1>Hola, bienvenid@</h1>
      <p>Este espacio nace del encuentro entre la ingeniería, la programación y la pasión por las artes y las letras. Aquí se investiga una pregunta central: ¿puede un texto programado generar emoción? A través de ensayos, prototipos y experimentos, esta bitácora explora cómo la escritura puede comportarse como un sistema vivo: reaccionar, enlazarse y transformarse sin perder profundidad estética.</p>
      
      <h2 id="posts-recientes">Posts Recientes:</h2>
      <ol class="latest-posts">
        {posts.map((post) => (
          <li>
            <article>
              <header>
                <h3>
                  <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
                </h3>
                <time datetime={post.data.pubDate.toISOString()}>
                  {formatDateET(post.data.pubDate)}
                </time>
              </header>
              <blockquote>
                {post.data.description}
              </blockquote>
            </article>
          </li>
        ))}
      </ol>
      
      <a href="/blog" class="all-posts-link">Todos los posts →</a>
    </aside>
  </div>
</Base>

