---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import HeaderToggle from '../../components/HeaderToggle.astro';

type StaticPath = { params: { slug: string }; props: { entry: CollectionEntry<'artifacts'> } };

export async function getStaticPaths(): Promise<StaticPath[]> {
  const artifactEntries = await getCollection('artifacts', ({ data }) => {
    return data.draft !== true;
  });

  return artifactEntries.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'artifacts'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();

// Compute prev/next navigation
const allEntries = await getCollection('artifacts', ({ data }) => data.draft !== true);
allEntries.sort((a, b) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate));
const currentIndex = allEntries.findIndex(e => e.slug === entry.slug);
const previous = allEntries[currentIndex + 1] || null;
const next = allEntries[currentIndex - 1] || null;

const bgImages = entry.data.backgroundImages
  ? await Promise.all(entry.data.backgroundImages.map((src) => getImage({ src })))
  : [];
---

<Base title={entry.data.title} description={entry.data.description} pageType="artifact" hideHeader={true}>
  {bgImages.length > 0 && (
    <div class="artifact-bg-container" aria-hidden="true">
      {bgImages.map((img, i) => (
        <div
          class="artifact-bg"
          data-bg-index={i}
          style={`--bg-image: url(${img.src})`}
        ></div>
      ))}
    </div>
  )}
  <HeaderToggle title={entry.data.title} />

  <div class="spacer-large" aria-hidden="true"></div>

  <article class="artifact-container">
    <!-- Ceremonial Title -->
    <h1 class="artifact-title">
      <span class="artifact-title-main">{entry.data.title}</span>
      {entry.data.subtitle && (
        <span class="artifact-title-connector">{entry.data.subtitle}</span>
      )}
    </h1>

    {entry.data.version && (
      <div class="artifact-metadata">
        <span class="artifact-version">v{entry.data.version}</span>
      </div>
    )}

    <div class="spacer-large" aria-hidden="true"></div>
    <div class="spacer-large" aria-hidden="true"></div>
    <div class="spacer-large" aria-hidden="true"></div>

    <!-- Content -->
    <div class="artifact-content">
      <Content />
    </div>

    <!-- Navigation -->
    <nav class="post-nav" aria-label="Navegación de artefactos">
      {previous ? (
        <a class="prev-post" href={`/artifacts/${previous.slug}/`} rel="prev">
          ← anterior
        </a>
      ) : <span />}

      {next ? (
        <a class="next-post" href={`/artifacts/${next.slug}/`} rel="next">
          siguiente →
        </a>
      ) : <span />}
    </nav>
  </article>
</Base>

<style>
  .artifact-bg-container {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .artifact-bg {
    position: absolute;
    inset: 0;
    background-image: var(--bg-image);
    background-size: cover;
    background-position: center 30%;
    background-repeat: no-repeat;
    opacity: 0;
  }

  .artifact-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 var(--space-60);
  }

  .post-nav {
    display: flex;
    justify-content: center;
    gap: 100px;
    margin: var(--space-70) 0;
    font-family: 'DM Mono', monospace;
  }

  .post-nav a {
    color: var(--color-secondary);
    text-decoration: none;
    font-size: var(--font-size-small);
    transition: color 0.2s ease;
  }

  .post-nav a:hover {
    color: var(--color-primary);
  }

  .artifact-metadata {
    text-align: center;
  }

  .artifact-version {
    font-family: 'DM Mono', monospace;
    font-size: var(--font-size-small);
    color: var(--color-tertiary);
  }
</style>
