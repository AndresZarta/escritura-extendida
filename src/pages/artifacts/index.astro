---
import Base from "../../layouts/Base.astro";
import HeaderToggle from "../../components/HeaderToggle.astro";
import { getCollection } from "astro:content";
import { formatCoercedDateAsCalendar } from '../../utils/formatDateET';

const allArtifacts = await getCollection('artifacts', ({ data }) => {
  return data.draft !== true;
});

const artifacts = allArtifacts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Base title="Artefactos - escritura::extendida" pageType="artifact-list" hideHeader={true}>
  <HeaderToggle title="Artefactos - escritura::extendida" />

  <div class="spacer-large" aria-hidden="true"></div>

  <div class="artifacts-container">
    <div class="artifacts-intro">
      <h1 class="artifacts-heading">Artefactos</h1>
      <p class="artifacts-description">
        Piezas literarias inseparables del medio digital que las alberga. Cada artefacto es versionado: abierto a la modificación, documentado en su evolución.
      </p>
    </div>

    <hr />

    <section class="artifacts-list">
      {artifacts.map((artifact) => (
        <article class="artifact-item">
          <h2 class="artifact-item-title">
            <a href={`/artifacts/${artifact.slug}/`}>
              {artifact.data.title}
              {artifact.data.subtitle && (
                <span class="artifact-item-subtitle">{artifact.data.subtitle}</span>
              )}
            </a>
          </h2>

          {artifact.data.version && (
            <span class="artifact-item-version">v{artifact.data.version}</span>
          )}

          <time class="artifact-item-date" datetime={artifact.data.pubDate.toISOString()}>
            {formatCoercedDateAsCalendar(artifact.data.pubDate)}
          </time>

          {artifact.data.experienciaDeLectura && (
            <p class="artifact-item-reading-experience">{artifact.data.experienciaDeLectura}</p>
          )}

          {artifact.data.description && (
            <p class="artifact-item-description">
              {artifact.data.description}
            </p>
          )}
        </article>
      ))}
    </section>
  </div>
</Base>

<style>
  .artifacts-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 var(--space-60);
  }

  .artifacts-intro {
    text-align: center;
    margin-bottom: var(--space-70);
  }

  .artifacts-heading {
    font-family: var(--font-family-artifact);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 500;
    color: var(--color-secondary);
    margin-bottom: var(--space-30);
  }

  .artifacts-description {
    font-family: var(--font-family-artifact);
    font-size: 1.125rem;
    font-style: italic;
    color: var(--color-tertiary);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .artifacts-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-70);
    margin-top: var(--space-70);
  }

  .artifact-item {
    text-align: center;
    padding: var(--space-60) 0;
    border-bottom: 1px solid var(--color-accent-3);
  }

  .artifact-item:last-child {
    border-bottom: none;
  }

  .artifact-item-title {
    font-family: var(--font-family-artifact);
    font-size: 1.75rem;
    font-weight: 500;
    margin: 0 0 var(--space-30);
    line-height: 1.3;
  }

  .artifact-item-title a {
    color: var(--color-secondary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .artifact-item-title a:hover {
    color: var(--color-primary);
  }

  .artifact-item-subtitle {
    display: block;
    font-size: 0.7em;
    font-style: italic;
    font-weight: 400;
    opacity: 0.7;
    margin-top: 0.5rem;
  }

  .artifact-item-date {
    display: block;
    font-family: 'DM Mono', monospace;
    font-size: var(--font-size-small);
    color: var(--color-tertiary);
    margin-bottom: var(--space-30);
  }

  .artifact-item-version {
    display: block;
    font-family: 'DM Mono', monospace;
    font-size: var(--font-size-small);
    color: var(--color-tertiary);
    margin-bottom: var(--space-20);
  }

  .artifact-item-reading-experience {
    font-family: 'DM Mono', monospace;
    font-size: var(--font-size-small);
    font-style: italic;
    color: var(--color-tertiary);
    max-width: 500px;
    margin: var(--space-30) auto 0;
    line-height: 1.5;
  }

  .artifact-item-description {
    font-family: 'DM Mono', monospace;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-secondary);
    max-width: 600px;
    margin: var(--space-30) auto 0;
  }
</style>
