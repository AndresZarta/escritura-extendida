---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths, Page } from 'astro';
import { formatCoercedDateAsCalendar } from '../../utils/formatDateET';

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const allPosts = await getCollection('blog', ({ data }) => {
    return data.draft !== true;
  });

  const posts = allPosts
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  return paginate(posts, { pageSize: 10 });
};

type Props = {
  page: Page<CollectionEntry<'blog'>>;
};

const { page } = Astro.props;
---
<Base title="Blog - escritura::extendida">
  <!-- Spacer -->
  <div class="spacer-large" aria-hidden="true"></div>

  <!-- Posts Section -->
  <div class="posts-container">
    <aside class="intro-aside">
      <h2 id="todos-los-posts">Todos los Posts</h2>
      
      <ol class="latest-posts">
        {page.data.map((post: CollectionEntry<'blog'>) => (
          <li>
            <article>
              <header>
                <h3>
                  <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
                </h3>
                <time datetime={post.data.pubDate.toISOString()}>
                  {formatCoercedDateAsCalendar(post.data.pubDate)}
                </time>
              </header>
              <blockquote>
                {post.data.description}
              </blockquote>
            </article>
          </li>
        ))}
      </ol>

      <!-- Pagination controls -->
      <nav class="pagination" aria-label="Paginación de posts">
        {page.url.prev ? (
          <a class="pagination-prev" href={page.url.prev} rel="prev">← ./anterior</a>
        ) : (<span />)}

        <div class="pagination-pages">
          {Array.from({ length: page.lastPage }).map((_, i) => {
            const p = i + 1;
            const url = p === 1 ? '/blog' : `/blog/${p}`;
            return page.currentPage === p ? (
              <span class="pagination-current">{p}</span>
            ) : (
              <a class="pagination-page" href={url}>{p}</a>
            );
          })}
        </div>

        {page.url.next ? (
          <a class="pagination-next" href={page.url.next} rel="next">./siguiente →</a>
        ) : (<span />)}
      </nav>
    </aside>
  </div>
</Base>
