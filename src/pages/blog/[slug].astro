---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatCoercedDateAsCalendar, isSameCalendarDay } from '../../utils/formatDateET';

type StaticPath = { params: { slug: string }; props: { entry: CollectionEntry<'blog'> } };

export async function getStaticPaths(): Promise<StaticPath[]> {
  const blogEntries = await getCollection('blog');
  return blogEntries.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();

// Extraer fechas para uso seguro en JSX
const pubDate = entry.data.pubDate;
const upDate = entry.data.upDate;

// Determinar si mostrar fecha de actualización
const hasUpdate = upDate && !isSameCalendarDay(pubDate, upDate);

// Compute previous / next entries for navigation
const allEntries = await getCollection('blog');
// Sort by pubDate descending (newest first)
allEntries.sort((a, b) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate));
const currentIndex = allEntries.findIndex(e => e.slug === entry.slug);
const previous = currentIndex >= 0 && currentIndex + 1 < allEntries.length ? allEntries[currentIndex + 1] : null;
const next = currentIndex > 0 ? allEntries[currentIndex - 1] : null;

// Store post index for directional transitions
const postIndex = currentIndex;
---

<Base title={entry.data.title} description={entry.data.description} pageType="post" postIndex={postIndex}>
  <!-- Spacer -->
  <div class="spacer-large" aria-hidden="true"></div>

  <!-- Blog Post -->
  <div class="page-container">
    <article class="page-content">
      <h1 class="page-title blog-title-with-exec">{entry.data.title}</h1>
      
      <div class="post-dates">
        <time class="page-date" datetime={pubDate.toISOString()}>
          Publicado: {formatCoercedDateAsCalendar(pubDate)}
        </time>
        
        {hasUpdate && upDate && (
          <time class="page-date page-date-updated" datetime={upDate.toISOString()}>
            Actualizado: {formatCoercedDateAsCalendar(upDate)}
          </time>
        )}
      </div>

      <div class="page-body">
        <Content />
      </div>
    
      <!-- Prev / Next navigation -->
      <nav class="post-nav" aria-label="Navegación de entradas">
        {previous ? (
          <a class="prev-post" href={`/blog/${previous.slug}/`} rel="prev">
            ← ./anterior
          </a>
        ) : <span />}

        {next ? (
          <a class="next-post" href={`/blog/${next.slug}/`} rel="next">
            ./siguiente →
          </a>
        ) : <span />}
      </nav>
    </article>
  </div>
</Base>

<style>
  /* Only blog-specific styling: the ./ prefix */
  .blog-title-with-exec {
    padding-left: 1.5em;
  }

  .blog-title-with-exec::before {
    content: './';
    display: inline-block;
    margin-left: -1.5em;
    width: 1.5em;
    color: var(--color-accent-4);
    font-weight: normal;
  }

  .blog-title-with-exec:hover::before {
    color: var(--color-primary);
  }

  /* Post dates — mobile: stacked */
  .post-dates {
    display: flex;
    flex-direction: column;
    gap: var(--space-30);
    margin-bottom: var(--space-60);
  }

  @media (min-width: 640px) {
    .post-dates {
      flex-direction: row;
      gap: var(--space-60);
    }
  }

  .page-date-updated {
    color: var(--color-tertiary);
  }
</style>
