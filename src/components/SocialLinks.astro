---
interface Link { href: string; label: string; icon?: string }
const { links = [] as Link[] } = Astro.props;
---

<ul class="social">
  {links.map((l: Link) => {
    const iconName = l.icon ?? l.label.toLowerCase().replace(/\s+/g, '-')
      .replace(/[^a-z0-9-]/g, '')
    const iconSrc = `/icons/${iconName}.svg`;
    return (
      <li>
        <a href={l.href} rel="me noopener" target="_blank" aria-label={l.label}>
          <img src={iconSrc} alt="" width="18" height="18" />
          <span class="sr-only">{l.label}</span>
        </a>
      </li>
    )
  })}
</ul>

<style>
  .sr-only {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }
</style>
