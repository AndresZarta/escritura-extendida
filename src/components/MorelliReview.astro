---
---

<div class="morelli-trigger" data-morelli-review>
  <slot />
</div>

<style>
  .morelli-trigger {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .morelli-trigger :global(p) {
    cursor: pointer;
    transition: border-left 0.3s ease, padding-left 0.3s ease;
    border-left: 2px solid transparent;
    margin: 0;
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
  }

  .morelli-trigger :global(> p:first-child) {
    padding-top: 0;
  }

  .morelli-trigger :global(> p:last-of-type) {
    padding-bottom: 0;
  }

  .morelli-trigger.mr-active :global(p) {
    border-left: 2px solid rgba(139, 37, 0, 0.3);
    padding-left: 12px;
  }
  /* Strikethrough */
  .morelli-trigger :global(.mr-strike) {
    position: relative;
    transition: color 0.4s ease;
    transition-delay: var(--mr-delay, 0s);
  }

  .morelli-trigger.mr-active :global(.mr-strike) {
    color: rgba(26, 24, 20, 0.45);
  }

  .morelli-trigger :global(.mr-strike::after) {
    content: '';
    position: absolute;
    left: -2px;
    right: -2px;
    top: 52%;
    height: 1.5px;
    background: rgba(139, 37, 0, 0.7);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s ease;
    transition-delay: var(--mr-delay, 0s);
  }

  .morelli-trigger.mr-active :global(.mr-strike::after) {
    transform: scaleX(1);
  }

  /* Underline emphasis */
  .morelli-trigger :global(.mr-underline) {
    border-bottom: 1.5px solid transparent;
    padding-bottom: 1px;
    transition: border-bottom-color 0.4s ease;
    transition-delay: var(--mr-delay, 0s);
  }

  .morelli-trigger.mr-active :global(.mr-underline) {
    border-bottom-color: rgba(139, 37, 0, 0.8);
    border-bottom-style: wavy;
  }

  /* Annotation wrapper — grid for smooth height animation */
  .morelli-trigger :global(.mr-note-wrap) {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    margin: 0;
    transition: grid-template-rows 0.5s ease, opacity 0.4s ease, margin 0.5s ease;
    transition-delay: var(--mr-delay, 0s);
  }

  .morelli-trigger.mr-active :global(.mr-note-wrap) {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .morelli-trigger :global(.mr-note-inner) {
    overflow: hidden;
    min-height: 0;
  }

  /* Interlinear note */
  .morelli-trigger :global(.mr-interlinear) {
    font-family: 'Caveat', cursive;
    color: #8b2500;
    font-size: 17px;
    font-weight: 500;
    margin: 4px 0 8px;
    padding-left: 20px;
    line-height: 1.4;
    max-width: 99%;
    overflow-wrap: break-word;
  }

  /* Block note */
  .morelli-trigger :global(.mr-block) {
    font-family: 'Caveat', cursive;
    color: #8b2500;
    font-size: 17.5px;
    font-weight: 500;
    line-height: 1.55;
    margin: 12px 0 16px;
    padding: 14px 20px 14px 22px;
    border-left: 2px solid rgba(139, 37, 0, 0.7);
    background: rgba(139, 37, 0, 0.08);
    max-width: 99%;
    overflow-wrap: break-word;
  }

  .morelli-trigger :global(.mr-signature) {
    display: block;
    text-align: right;
    font-size: 15.5px;
    margin-top: 8px;
    opacity: 0.7;
    font-style: italic;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-morelli-review]').forEach((container) => {
    const paragraphs = Array.from(container.querySelectorAll(':scope > p'));
    if (paragraphs.length < 4) return;

    // --- Helpers ---

    function wrapPhrase(el: Element, phrase: string, className: string, delay: number): HTMLElement | null {
      const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
      let node: Text | null;
      while ((node = walker.nextNode() as Text | null)) {
        const text = node.textContent ?? '';
        const idx = text.indexOf(phrase);
        if (idx === -1) continue;

        const range = document.createRange();
        range.setStart(node, idx);
        range.setEnd(node, idx + phrase.length);

        const span = document.createElement('span');
        span.className = className;
        span.dataset.mrDelay = String(delay);
        span.style.setProperty('--mr-delay', `${delay}s`);
        range.surroundContents(span);
        return span;
      }
      return null;
    }

    function createNote(html: string, type: 'interlinear' | 'block', delay: number): HTMLElement {
      const wrap = document.createElement('div');
      wrap.className = 'mr-note-wrap';
      wrap.dataset.mrDelay = String(delay);
      wrap.style.setProperty('--mr-delay', `${delay}s`);

      const inner = document.createElement('div');
      inner.className = 'mr-note-inner';

      const content = document.createElement('div');
      content.className = type === 'interlinear' ? 'mr-interlinear' : 'mr-block';
      content.innerHTML = html;

      inner.appendChild(content);
      wrap.appendChild(inner);
      return wrap;
    }

    function insertNotesAfter(ref: Element, notes: HTMLElement[]): void {
      let current = ref;
      for (const note of notes) {
        current.after(note);
        current = note;
      }
    }

    // --- Paragraph 1 ---
    const p1 = paragraphs[0];
    // Wrap the full parenthetical by finding "(" and ")" in a text node
    {
      const walker = document.createTreeWalker(p1, NodeFilter.SHOW_TEXT);
      let tNode: Text | null;
      while ((tNode = walker.nextNode() as Text | null)) {
        const t = tNode.textContent ?? '';
        const openIdx = t.indexOf('(');
        const closeIdx = t.indexOf(')', openIdx);
        if (openIdx === -1 || closeIdx === -1) continue;
        const range = document.createRange();
        range.setStart(tNode, openIdx);
        range.setEnd(tNode, closeIdx + 1);
        const span = document.createElement('span');
        span.className = 'mr-strike';
        span.dataset.mrDelay = '0.3';
        span.style.setProperty('--mr-delay', '0.3s');
        range.surroundContents(span);
        break;
      }
    }

    insertNotesAfter(p1, [
      createNote(
        'El paréntesis es la cocina. Yo confieso esto, yo me enteré de aquello. ¿Y a quién le importa cómo te enteraste? Se te cuela el torpe guionista de cine donde debería haber un escritor. (Pero cuidado con la trampa de creer que sacando el paréntesis ya llegás a alguna parte. Por algo lo dejaste ahí, che.)',
        'interlinear', 0.7
      ),
    ]);

    // --- Paragraph 2 ---
    const p2 = paragraphs[1];
    wrapPhrase(p2, 'vestidas en traje de cóctel,', 'mr-strike', 1.0);
    wrapPhrase(p2, 'casi como', 'mr-strike', 1.15);
    wrapPhrase(p2, 'a la que rechacé ir', 'mr-strike', 1.3);
    wrapPhrase(p2, 'curiosidad y también con', 'mr-strike', 1.45);

    insertNotesAfter(p2, [
      createNote(
        '«Casi como un escudo.» El <em>casi</em> es cobardía tuya. Si el libro es un escudo, que lo sea; si no lo es, que no esté. Lo mismo con «curiosidad y también con miedo»: ese «también» pone dos fuerzas enemigas a convivir educadamente, como señoras en un ascensor. Lo que vos viste en esa mirada no era eso — era algo que no sabés nombrar y por eso le ponés dos nombres que no son.',
        'interlinear', 1.7
      ),
      createNote(
        '«Traje de cóctel.» Vestuario. Maquillaje. ¿Para qué me lo contás si ni lo recordás? Si esto es tu memoria de alguien que perdiste, dame lo que recordás de verdad — un gesto, un olor, el ruido de un vaso — y no la escenografía.',
        'interlinear', 2.0
      ),
    ]);

    // --- Paragraph 3 ---
    const p3 = paragraphs[2];
    wrapPhrase(p3, 'me odiaba', 'mr-underline', 2.4);

    insertNotesAfter(p3, [
      createNote(
        'Aquí pasa algo y no estoy seguro de que lo sepas. La sirena de piedra y el odio son la misma figura — lo que se petrifica, lo que no se puede mover. Y la frase funciona justamente porque llega desnuda, sin adjetivos, sin cocina: «me dijo que me odiaba y que prefería que me fuera.» No la toques. Pero preguntate por qué todo lo que viene antes necesita tanta ropa para decirse y esto no necesita ninguna. Ahí está la pista de lo que tu texto debería ser y todavía no es.<br><br>(¿O será que la figura es otra — que recordás la sirena y las escaleras y la catedral pero ya no podés recordarla a <em>ella</em>, y entonces llenás el espacio con topografía? Si es eso, es más interesante de lo que parece. Pero entonces hacelo a propósito, no por distracción.)<span class="mr-signature">— M.</span>',
        'block', 2.7
      ),
    ]);

    // --- Paragraph 4 ---
    const p4 = paragraphs[3];
    wrapPhrase(p4, 'ella con su vestido rojo, ya diferente y hecha toda una mujer, y yo con mi camisa blanca y pantalones caqui', 'mr-strike', 3.1);
    wrapPhrase(p4, 'ninguno pudo entonces resistir la intoxicante atracción que pronto se formó entre nosotros', 'mr-strike', 3.3);
    wrapPhrase(p4, 'nos entregamos a un romance que desafiaría el tiempo y transcurriría por su propia cuenta durante ese largo verano en la isla.', 'mr-strike', 3.5);

    insertNotesAfter(p4, [
      createNote(
        '«Hecha toda una mujer.» Esto lo dice un tío borracho en Navidad, no un escritor. Y vos lo sabés — tenés que saberlo — porque tres líneas arriba escribiste lo de la sirena de piedra. ¿Cómo pasás de la sirena a «hecha toda una mujer»? Pasás porque dejás de escribir y empezás a rellenar.',
        'interlinear', 3.8
      ),
      createNote(
        '«La intoxicante atracción.» «Un romance que desafiaría el tiempo.» Esto no es lenguaje — es el fantasma del lenguaje. Palabras que ya vienen muertas, premasticadas, hedónicas. Poné «la intoxicante atracción» al lado de la sirena de piedra y sentí la diferencia: una es una figura, la otra es aire pintado de figura. Un cadáver perfumado.',
        'interlinear', 4.1
      ),
      createNote(
        'Lo grave: «diez años más tarde en la tienda de antigüedades» es lo mejor del párrafo y tal vez del segmento. Una tienda de antigüedades — un lugar donde las cosas sobreviven a quienes las amaron. Encontrarse ahí es ya una figura, no necesita que le expliques nada. Pero le tenés miedo al vacío y entonces le ponés vestido rojo y camisa blanca y «intoxicante atracción» y «romance que desafiaría el tiempo», como quien le pone un suéter a un perro.<br><br>La resta. Siempre la resta. Atrevete a escribir: «Y luego, diez años más tarde, nos encontramos en la tienda de antigüedades.» Y después nada. Que el lector haga el trabajo o que se vaya a leer otra cosa. No estamos aquí para premásticarle la emoción a nadie.<br><br>Andá a leer el 116 de Rayuela.<span class="mr-signature">— M.</span>',
        'block', 4.7
      ),
    ]);

    // --- Hover handling ---
    let leaveTimer: number;

    container.addEventListener('mouseenter', () => {
      clearTimeout(leaveTimer);
      // Restore original delays
      container.querySelectorAll<HTMLElement>('[data-mr-delay]').forEach((el) => {
        el.style.setProperty('--mr-delay', el.dataset.mrDelay + 's');
      });
      container.classList.add('mr-active');
    });

    container.addEventListener('mouseleave', () => {
      leaveTimer = window.setTimeout(() => {
        // Set all delays to 0 for instant reverse
        container.querySelectorAll<HTMLElement>('[data-mr-delay]').forEach((el) => {
          el.style.setProperty('--mr-delay', '0s');
        });
        container.classList.remove('mr-active');
      }, 400);
    });
  });
</script>
