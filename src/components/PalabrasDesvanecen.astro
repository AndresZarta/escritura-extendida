---
interface Props {
  /** Min opacity a word can fade to (default 0.05) */
  minOpacity?: number;
  /** Duration range for a fade cycle in ms (default 2000-5000) */
  minCycleDuration?: number;
  maxCycleDuration?: number;
  /** Fraction of words fading at any given time (default 0.3) */
  activeFraction?: number;
}

const {
  minOpacity = 0.05,
  minCycleDuration = 2000,
  maxCycleDuration = 5000,
  activeFraction = 0.3,
} = Astro.props;
---

<div
  class="palabras-desvanecen"
  data-pd-min-opacity={minOpacity}
  data-pd-min-cycle={minCycleDuration}
  data-pd-max-cycle={maxCycleDuration}
  data-pd-active-fraction={activeFraction}
><slot /></div>

<style>
  .palabras-desvanecen {
    position: relative;
  }

  .palabras-desvanecen :global(.pd-word) {
    display: inline;
    transition: none; /* opacity controlled by JS */
  }
</style>

<script>
  import { observeVisibility } from '../utils/observeVisibility';

  document.querySelectorAll<HTMLElement>('.palabras-desvanecen').forEach((container) => {
    const minOpacity = parseFloat(container.dataset.pdMinOpacity ?? '0.05');
    const minCycle = parseFloat(container.dataset.pdMinCycle ?? '2000');
    const maxCycle = parseFloat(container.dataset.pdMaxCycle ?? '5000');
    const activeFraction = parseFloat(container.dataset.pdActiveFraction ?? '0.3');

    // Wrap each word in a span
    const walker = document.createTreeWalker(container, NodeFilter.SHOW_TEXT);
    const textNodes: Text[] = [];
    let node: Text | null;
    while ((node = walker.nextNode() as Text | null)) {
      if (node.textContent && node.textContent.trim()) textNodes.push(node);
    }

    const wordSpans: HTMLSpanElement[] = [];

    for (const textNode of textNodes) {
      const text = textNode.textContent ?? '';
      const parts = text.split(/(\s+)/);
      const fragment = document.createDocumentFragment();

      for (const part of parts) {
        if (part.match(/^\s+$/)) {
          fragment.appendChild(document.createTextNode(part));
        } else if (part.length > 0) {
          const span = document.createElement('span');
          span.className = 'pd-word';
          span.textContent = part;
          span.style.opacity = '1';
          fragment.appendChild(span);
          wordSpans.push(span);
        }
      }

      textNode.parentNode?.replaceChild(fragment, textNode);
    }

    if (wordSpans.length === 0) return;

    // Per-word state
    interface WordState {
      phase: 'visible' | 'fading-out' | 'faded' | 'fading-in';
      opacity: number;
      cycleStart: number;
      cycleDuration: number;
      holdDuration: number; // how long to stay faded
    }

    const states: WordState[] = wordSpans.map(() => ({
      phase: 'visible',
      opacity: 1,
      cycleStart: 0,
      cycleDuration: 0,
      holdDuration: 0,
    }));

    function randomCycleDuration(): number {
      return minCycle + Math.random() * (maxCycle - minCycle);
    }

    // How many words should be actively fading at any time
    const targetActive = Math.max(1, Math.floor(wordSpans.length * activeFraction));

    function countActive(): number {
      let c = 0;
      for (const s of states) {
        if (s.phase !== 'visible') c++;
      }
      return c;
    }

    function startFading(idx: number, now: number): void {
      const s = states[idx];
      s.phase = 'fading-out';
      s.cycleStart = now;
      s.cycleDuration = randomCycleDuration();
      s.holdDuration = 500 + Math.random() * 1500;
    }

    // Seed some initial fades with staggered starts
    const now = performance.now();
    const indices = Array.from({ length: wordSpans.length }, (_, i) => i);
    indices.sort(() => Math.random() - 0.5);
    for (let i = 0; i < targetActive && i < indices.length; i++) {
      startFading(indices[i], now - Math.random() * randomCycleDuration());
    }

    let frameId: number;

    function animate(): void {
      const now = performance.now();

      for (let i = 0; i < states.length; i++) {
        const s = states[i];

        if (s.phase === 'fading-out') {
          const elapsed = now - s.cycleStart;
          const progress = Math.min(1, elapsed / s.cycleDuration);
          // Ease out
          const eased = 1 - Math.pow(1 - progress, 2);
          s.opacity = 1 - eased * (1 - minOpacity);
          wordSpans[i].style.opacity = String(s.opacity);

          if (progress >= 1) {
            s.phase = 'faded';
            s.cycleStart = now;
            s.opacity = minOpacity;
          }
        } else if (s.phase === 'faded') {
          // Hold at min opacity for a bit
          if (now - s.cycleStart >= s.holdDuration) {
            s.phase = 'fading-in';
            s.cycleStart = now;
            s.cycleDuration = randomCycleDuration() * 0.7; // fade in slightly faster
          }
        } else if (s.phase === 'fading-in') {
          const elapsed = now - s.cycleStart;
          const progress = Math.min(1, elapsed / s.cycleDuration);
          // Ease in
          const eased = progress * progress;
          s.opacity = minOpacity + eased * (1 - minOpacity);
          wordSpans[i].style.opacity = String(s.opacity);

          if (progress >= 1) {
            s.phase = 'visible';
            s.opacity = 1;
            wordSpans[i].style.opacity = '1';
          }
        }
      }

      // Recruit new words to fade if we're below target
      const active = countActive();
      if (active < targetActive) {
        // Pick a random visible word
        const visibleIndices: number[] = [];
        for (let i = 0; i < states.length; i++) {
          if (states[i].phase === 'visible') visibleIndices.push(i);
        }
        if (visibleIndices.length > 0) {
          const pick = visibleIndices[Math.floor(Math.random() * visibleIndices.length)];
          startFading(pick, now);
        }
      }

      frameId = requestAnimationFrame(animate);
    }

    let visible = false;

    observeVisibility(container,
      () => { if (!visible) { visible = true; frameId = requestAnimationFrame(animate); } },
      () => { if (visible) { visible = false; cancelAnimationFrame(frameId); } }
    );
  });
</script>
