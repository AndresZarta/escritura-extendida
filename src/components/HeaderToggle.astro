---
import Header from "./Header.astro";
const { title } = Astro.props;
---

<div class="header-toggle-container">
  <button
    id="header-toggle-btn"
    class="header-toggle-btn"
    aria-label="Toggle navigation"
    aria-expanded="false"
  >
    <span class="toggle-icon">+</span>
  </button>

  <div id="collapsible-header" class="collapsible-header" aria-hidden="true">
    <Header title={title} />
  </div>
</div>

<style>
  .header-toggle-container {
    position: relative;
  }

  .header-toggle-btn {
    position: fixed;
    top: var(--space-50);
    right: var(--space-50);
    z-index: 1001;
    background: var(--color-base);
    border: 1px solid var(--color-accent-3);
    border-radius: 4px;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-family: 'DM Mono', monospace;
    font-size: 1.5rem;
    color: var(--color-secondary);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  /* Move button down when header is visible to avoid overlap */
  .header-toggle-btn[aria-expanded="true"] {
    top: calc(var(--header-height, 120px) + var(--space-30));
  }

  .header-toggle-btn:hover {
    background: var(--color-accent-2);
    border-color: var(--color-primary);
    color: var(--color-primary);
    transform: scale(1.05);
  }

  .header-toggle-btn:active {
    transform: scale(0.95);
  }

  .toggle-icon {
    display: block;
    line-height: 1;
    transition: transform 0.3s ease;
  }

  .header-toggle-btn[aria-expanded="true"] .toggle-icon {
    transform: rotate(45deg);
  }

  .collapsible-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 999;
    background: var(--color-base);
    transform: translateY(-100%);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .collapsible-header.is-visible {
    transform: translateY(0);
  }

  /* Adjust for artifact background */
  [data-page-type="artifact"] .header-toggle-btn,
  [data-page-type="artifact-list"] .header-toggle-btn {
    background: var(--artifact-bg);
  }

  [data-page-type="artifact"] .collapsible-header,
  [data-page-type="artifact-list"] .collapsible-header {
    background: var(--artifact-bg);
  }

  @media (max-width: 640px) {
    .header-toggle-btn {
      top: var(--space-30);
      right: var(--space-30);
      width: 36px;
      height: 36px;
      font-size: 1.25rem;
    }
  }
</style>

<script>
  function initHeaderToggle(): void {
    const toggleBtn = document.getElementById('header-toggle-btn');
    const header = document.getElementById('collapsible-header');

    if (!toggleBtn || !header) return;

    // Calculate and set header height as CSS variable
    const updateHeaderHeight = (): void => {
      const headerHeight = header.scrollHeight;
      document.documentElement.style.setProperty('--header-height', `${headerHeight}px`);
    };

    // Initial calculation
    updateHeaderHeight();

    // Recalculate on window resize
    window.addEventListener('resize', updateHeaderHeight);

    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      const newState = !isExpanded;

      toggleBtn.setAttribute('aria-expanded', String(newState));
      header.setAttribute('aria-hidden', String(!newState));

      if (newState) {
        header.classList.add('is-visible');
        updateHeaderHeight(); // Update height when opening
      } else {
        header.classList.remove('is-visible');
      }
    });

    // Close header when clicking outside
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!toggleBtn.contains(target) && !header.contains(target)) {
        if (toggleBtn.getAttribute('aria-expanded') === 'true') {
          toggleBtn.setAttribute('aria-expanded', 'false');
          header.setAttribute('aria-hidden', 'true');
          header.classList.remove('is-visible');
        }
      }
    });

    // Close header on escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggleBtn.getAttribute('aria-expanded') === 'true') {
        toggleBtn.setAttribute('aria-expanded', 'false');
        header.setAttribute('aria-hidden', 'true');
        header.classList.remove('is-visible');
      }
    });
  }

  // Initialize on page load
  initHeaderToggle();

  // Re-initialize after view transitions
  document.addEventListener('astro:after-swap', () => {
    initHeaderToggle();
  });
</script>
