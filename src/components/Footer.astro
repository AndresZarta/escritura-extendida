---
const currentYear = new Date().getFullYear();
---

<div class="footer-container">
  <footer class="site-footer">
    <p class="footer-title">
      <code>escritura::expandida</code> © {currentYear}
    </p>
    
    <p class="footer-credit">
      Este proyecto ha sido posible gracias al Fondo un TICket para el Futuro del Ministerio TIC e Icetex. Colombia.
    </p>
  </footer>
</div>

<style>
  .footer-container {
    width: 100%;
    padding: var(--space-60) var(--space-60);
    margin: 0;
  }

  .site-footer {
    max-width: var(--wide-width);
    margin: 0 auto;
    padding: 0;
    border-top: 1px solid var(--color-accent-3);
    padding-top: var(--space-60);
  }

  .footer-title {
    margin: 0 0 var(--space-30);
    font-size: var(--font-size-small);
    color: var(--color-secondary);
    font-weight: 300;
    line-height: 1.6;
  }

  .footer-title code {
    background-color: transparent;
    padding: 0;
    font-family: var(--font-family);
    font-size: inherit;
    color: inherit;
  }

  .footer-credit {
    margin: 0;
    font-size: var(--font-size-tiny);
    color: var(--color-secondary);
    font-weight: 300;
    line-height: 1.6;
  }

  .site-footer a {
    color: var(--color-secondary);
    text-decoration: none;
  }

  .site-footer a:hover {
    background-color: var(--color-accent-5);
    color: var(--color-primary);
  }

  @media (max-width: 640px) {
    .footer-container {
      padding: var(--space-50);
    }

    .site-footer {
      padding-top: var(--space-50);
    }

    .footer-title {
      font-size: var(--font-size-medium);
    }

    .footer-credit {
      font-size: var(--font-size-small);
    }
  }
</style>