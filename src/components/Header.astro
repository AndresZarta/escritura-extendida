---
import { SITE } from "../config";
import VersionTag from "./VersionTag.astro";
---

<div class="header-container">
  <header class="site-header">
    <div class="header-contents">
			<!-- Titulo del sitio con link a la pagina principal -->
      <div class="header-start">
        <div class="branding-bundle">
          <div class="site-branding" style="position:relative;display:inline-flex;align-items:flex-end;">
            <a href="/" class="site-title" style="font-size:2rem;text-decoration:none;line-height:1;">
              {SITE.title}
            </a>
            <span style="position:relative;bottom:-0.2em;margin-left:0.25rem;opacity:.6;font-size:.75rem;">
              <VersionTag />
            </span>
          </div>
          <p class="site-tagline">{SITE.tagline}</p>
        </div>
      </div>

      <!-- Navigation Group -->
      <div class="header-end">
        <nav class="site-navigation">
          <ul class="nav-menu">
            <li><a href="/">./inicio</a></li>
            <li><a href="/blog/init_escritura_extendida">./init_escritura_extendida</a></li>
            <li><a href="/blog">./blog</a></li>
            <li><a href="/artifacts">./artefactos</a></li>
            <li><a href="/about">./sobre_mí</a></li>
          </ul>
        </nav>
      </div>
    </div>
  </header>
</div>

<style>
  .header-container {
    width: 100%;
    padding: var(--space-30) var(--space-50);
    margin: 0;
  }

  .site-header {
    max-width: var(--wide-width);
    margin: 0 auto;
    padding: 0;
    border-bottom: none;
  }

  .header-contents {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: nowrap;
    margin: 0;
    padding: 0;
  }

  .header-start,
  .header-end {
    display: flex;
    align-items: center;
    gap: var(--space-30);
  }

  .site-branding {
    display: flex;
    align-items: center;
  }

  .branding-bundle {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
  }

  .site-title {
    font-size: var(--font-size-large);
    font-weight: 300;
    color: var(--color-primary);
    text-decoration: none;
    margin: 0;
  }

  .site-title:hover {
    background-color: var(--color-accent-2);
    color: var(--color-primary);
  }

  .site-navigation {
    display: flex;
  }

  .nav-menu {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: var(--space-30);
    flex-wrap: nowrap;
  }

  .nav-menu li {
    margin: 0;
  }

  .nav-menu a {
    color: var(--color-secondary);
    text-decoration: none;
    font-size: var(--font-size-medium);
    font-weight: 300;
    padding: 4px 8px;
    display: block;
    transition: all 0.2s ease;
  }

  .nav-menu a:hover {
    background-color: var(--color-accent-3);
    color: var(--color-secondary);
  }

  .site-tagline {
    display: inline-block;
    margin: var(--space-20) 0 0 0;
    overflow: hidden;
    white-space: nowrap;
    width: auto;
    max-width: 0;
    font-size: var(--font-size-small);
    color: var(--color-secondary);
    font-weight: 300;
    border-right: 2px solid var(--color-secondary);
    animation:
      typewriter 4s steps(80, end) 1s forwards,
      removeCursor 0s linear 5s forwards;
  }

  @keyframes typewriter {
    from { max-width: 0; }
    to   { max-width: 100%; }
  }

  @keyframes removeCursor {
    to { border-right: none; }
  }


/* Respect reduced motion preferences */
@media (prefers-reduced-motion: reduce) {
  .site-tagline {
    animation: none;
    border-right: none;
    width: 100%;
  }
}

@media (max-width: 640px) {
  .header-container {
    padding: var(--space-30);
  }

  .header-contents {
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-30);
  }

  .site-navigation {
    display: grid;
    flex-direction: row;

    margin-left: -10px;
  }

  /* Ensure the branding bundle stays left-aligned and can wrap internally */
  .branding-bundle {
    width: 100%;
    align-items: flex-start;
  }

  /* Make the tagline wrap on small screens and stop the typewriter animation */
  .site-tagline {
    white-space: normal;        /* allow wrapping */
    display: block;             /* behave as a block element */
    width: 100%;                /* full width under the title */
    max-width: none;            /* don't clip */
    overflow: visible;          /* show wrapped lines */
    border-right: none;         /* remove the typewriter cursor */
    animation: none;            /* disable animation on small screens */
    overflow-wrap: anywhere;    /* break long words/URLs if necessary */
    word-break: break-word;     /* extra safety for long strings */
    line-height: 1.2;           /* slightly tighter line height */
    margin-top: var(--space-10);
  }

  .nav-menu {
    flex-direction: column;
    gap: var(--space-20);
  }
}
</style>
