---
import { SITE } from "../config";
import VersionTag from "./VersionTag.astro";
---

<div class="header-container">
  <header class="site-header">
    <div class="header-contents">
      <!-- Titulo del sitio con link a la pagina principal -->
      <div class="header-start">
        <div class="branding-bundle">
          <div class="site-branding" style="position:relative;display:inline-flex;align-items:flex-end;">
            <a href="/" class="site-title">
              {SITE.title}
            </a>
            <span style="position:relative;bottom:-0.2em;margin-left:0.25rem;opacity:.6;font-size:.75rem;">
              <VersionTag />
            </span>
          </div>
          <div class="tagline-wrapper">
            <p class="site-tagline">{SITE.tagline}</p>
            <span class="tagline-cursor" aria-hidden="true"></span>
          </div>
        </div>
      </div>

      <!-- Navigation Group -->
      <div class="header-end">
        <nav class="site-navigation" id="site-nav">
          <ul class="nav-menu">
            <li><a href="/">./inicio</a></li>
            <li><a href="/blog/init_escritura_extendida">./init_escritura_extendida</a></li>
            <li><a href="/blog">./blog</a></li>
            <li><a href="/artifacts">./artefactos</a></li>
            <li><a href="/about">./sobre_mí</a></li>
          </ul>
        </nav>
      </div>
    </div>
  </header>
</div>

<script>
  // Mobile typewriter — character by character so text wraps naturally
  function setupMobileTypewriter() {
    if (window.innerWidth >= 640) return; // CSS animation handles desktop

    const taglineEl = document.querySelector<HTMLElement>('.site-tagline');
    const cursorEl = document.querySelector<HTMLElement>('.tagline-cursor');
    if (!taglineEl) return;

    const text = taglineEl.textContent?.trim() ?? '';

    // Reveal immediately if reduced motion is preferred
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      taglineEl.style.clipPath = 'none';
      return;
    }

    taglineEl.textContent = '';
    taglineEl.style.clipPath = 'none';
    taglineEl.style.animation = 'none';
    if (cursorEl) cursorEl.style.display = 'none';

    taglineEl.classList.add('is-typing');

    let i = 0;
    setTimeout(() => {
      const id = setInterval(() => {
        taglineEl.textContent = text.slice(0, ++i);
        if (i >= text.length) {
          clearInterval(id);
          setTimeout(() => taglineEl.classList.remove('is-typing'), 500);
        }
      }, 55);
    }, 1000);
  }

  setupMobileTypewriter();
  document.addEventListener('astro:page-load', setupMobileTypewriter);
</script>

<style>
  .header-container {
    width: 100%;
    padding: var(--space-30) var(--space-60);
    margin: 0;
  }

  .site-header {
    max-width: var(--wide-width);
    margin: 0 auto;
    padding: 0;
    border-bottom: none;
  }

  /* Mobile: stack title and nav vertically */
  .header-contents {
    display: flex;
    flex-direction: column;
    gap: var(--space-30);
    margin: 0;
    padding: 0;
  }

  .header-start {
    min-width: 0;
  }

  .header-end {
    display: flex;
    align-items: center;
  }

  .site-branding {
    display: flex;
    align-items: center;
  }

  .branding-bundle {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    width: 100%;   /* bound by .header-start so tagline wrapper can clip */
    min-width: 0;
  }

  .site-title {
    font-size: clamp(1.25rem, 5vw, 2rem);
    line-height: 1;
    font-weight: 300;
    color: var(--color-primary);
    text-decoration: none;
    margin: 0;
  }

  .site-title:hover {
    background-color: var(--color-accent-2);
    color: var(--color-primary);
  }

  /* Nav always visible, stacks vertically on mobile */
  .site-navigation {
    display: flex;
    width: 100%;
  }

  /* Nav links stack vertically on mobile */
  .nav-menu {
    display: flex;
    flex-direction: column;
    list-style: none;
    margin: var(--space-30) 0 0;
    padding: 0;
    gap: var(--space-20);
  }

  .nav-menu li {
    margin: 0;
  }

  .nav-menu a {
    color: var(--color-secondary);
    text-decoration: none;
    font-size: var(--font-size-medium);
    font-weight: 300;
    padding: 4px 8px;
    display: block;
    transition: all 0.2s ease;
  }

  .nav-menu a:hover {
    background-color: var(--color-accent-3);
    color: var(--color-secondary);
  }

  /* Tagline wrapper — mobile: bounds the tagline */
  .tagline-wrapper {
    position: relative;
    width: 100%;
    margin-top: var(--space-20);
  }

  /* Mobile: tagline starts hidden (clip), JS takes over */
  .site-tagline {
    display: block;
    margin: 0;
    white-space: normal; /* allow wrapping on mobile */
    font-size: var(--font-size-small);
    color: var(--color-secondary);
    font-weight: 300;
    clip-path: inset(0 100% 0 0); /* hidden until JS or desktop animation starts */
  }

  /* Mobile cursor via ::after while JS is typing */
  .site-tagline.is-typing::after {
    content: '|';
    display: inline;
    color: var(--color-secondary);
    animation: cursorBlink 0.7s step-start infinite;
  }

  /* Desktop cursor bar — hidden on mobile */
  .tagline-cursor {
    display: none;
  }

  @keyframes typewriter {
    from { clip-path: inset(0 100% 0 0); }
    to   { clip-path: inset(0 0% 0 0); }
  }

  @keyframes cursorSlide {
    from { left: 0%; }
    to   { left: 100%; }
  }

  @keyframes cursorBlink {
    50% { opacity: 0; }
  }

  @keyframes cursorDisappear {
    to { opacity: 0; }
  }

  /* Respect reduced motion preferences (desktop) */
  @media (prefers-reduced-motion: reduce) {
    .site-tagline {
      animation: none;
      clip-path: none;
    }

    .tagline-cursor {
      display: none !important;
    }
  }

  /* Desktop (640px+): show nav inline, hide hamburger, CSS typewriter */
  @media (min-width: 640px) {
    .header-contents {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }

    /* Title: sized to title text only (tagline is out of flow) */
    .header-start {
      flex: none;
    }

    /* Nav: shrinks as window narrows, clips content when squeezed */
    .header-end {
      flex: 0 1 auto;
      overflow: hidden;
      min-width: 0;
    }

    /* Nav links hold their full width so they overflow header-end (not compress) */
    .nav-menu a {
      white-space: nowrap;
    }

    .nav-menu {
      flex-direction: row;
      gap: var(--space-30);
      margin: 0;
    }

    /* Desktop: title sizes to its own text; tagline is out of flex flow */
    .branding-bundle {
      width: auto;
      position: relative;
      padding-bottom: calc(1.6rem + 4px);
    }

    .tagline-wrapper {
      position: absolute;
      bottom: 0;
      left: 0;
      width: max-content;
    }

    /* Desktop: CSS clip-path typewriter animation */
    .site-tagline {
      white-space: nowrap;
      animation: typewriter 4s steps(80, end) 1s forwards;
    }

    /* Desktop cursor bar */
    .tagline-cursor {
      display: block;
      position: absolute;
      top: 0;
      height: 1.5em;
      font-size: var(--font-size-small);
      left: 0;
      width: 2px;
      background-color: var(--color-secondary);
      animation:
        cursorSlide 4s steps(80, end) 1s forwards,
        cursorDisappear 0s 5s forwards;
    }
  }
</style>
